# Free API Keys
GROQ_API_KEY="gsk_..."
GEMINI_API_KEY="AIza..."
OPENROUTER_API_KEY="sk-or-..."

# Primary Model Routing (Active Groq models: openai/gpt-oss-120b, mistral-saba-24b)
