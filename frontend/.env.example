# ==============================================================================
# Cultural Alignment Layer (CAL) - Frontend Environment Template
# Copy this file to .env and configure local values.
# ==============================================================================

# Backend FastAPI Mediator URL (Local development endpoint)
VITE_MEDIATOR_API_URL=http://localhost:8000

# Client-Side Groq Fallback / Direct Provider Key (Optional client-side fallback)
VITE_GROQ_API_KEY=your_groq_api_key_here

# Client-Side Default Model Selection
VITE_GROQ_MODEL=openai/gpt-oss-120b
