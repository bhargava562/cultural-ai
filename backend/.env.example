# ==============================================================================
# Cultural Alignment Layer (CAL) - Backend Environment Template
# Copy this file to .env and provide your API keys.
# ==============================================================================

# ------------------------------------------------------------------------------
# Free-Tier LLM Provider API Keys
# ------------------------------------------------------------------------------
# Primary Groq API Key (Get free key from: https://console.groq.com)
GROQ_API_KEY="your_groq_api_key_here"

# Key Rotator Pool: Multiple keys to automatically circumvent rate limits (HTTP 429)
GROQ_API_KEY_1="your_first_groq_api_key"
GROQ_API_KEY_2="your_second_groq_api_key"

# Google Gemini API Key (Get free key from: https://aistudio.google.com)
GEMINI_API_KEY="your_gemini_api_key_here"

# OpenRouter API Key (Optional free tier fallback: https://openrouter.ai)
OPENROUTER_API_KEY="your_openrouter_api_key_here"

# ------------------------------------------------------------------------------
# Model Routing & Orchestration
# ------------------------------------------------------------------------------
# Primary generator model (Hosted on Groq: openai/gpt-oss-120b or mistral-saba-24b)
GENERATOR_MODEL="groq/openai/gpt-oss-120b"

# Cultural Judge Model (for evaluation rubric scoring)
JUDGE_MODEL="gemini/gemini-1.5-flash"

# ------------------------------------------------------------------------------
# Local Vector Database & Multilingual Embeddings
# ------------------------------------------------------------------------------
# Lightweight multilingual transformer for semantic retrieval
EMBEDDING_MODEL="sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2"

# Persistent ChromaDB storage path relative to backend directory
CHROMA_PERSIST_DIR="./vector_store/chroma_db"

# ------------------------------------------------------------------------------
# Cultural Alignment Thresholds & Interceptor Loop
# ------------------------------------------------------------------------------
# Minimum Cultural Alignment Score (CAS) required to accept a response [0.0 - 1.0]
SCORE_THRESHOLD=0.75

# Maximum feedback-guided refinement iterations
MAX_FEEDBACK_LOOPS=2
